# 🌍 TerraPlot — Earth Lens 2036 — Copy to .env and fill
# See README.md Quick start. All keys are free-tier.

# --- Core ---
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/xrplot
NEXT_PUBLIC_APP_URL=http://localhost:3000
# or VERCEL_URL auto

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- AI ---
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=sk-or-v1-...

# --- Maps ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key

# --- Storage ---
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...
CLOUDINARY_URL=cloudinary://...

# --- GEE (optional — without this, Earth Lens uses smart simulated fallback) ---
# Create service account at https://console.cloud.google.com/iam-admin/serviceaccounts
# Enable Earth Engine API, share asset, download JSON key
GEE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# OR split:
# GEE_CLIENT_EMAIL=your-sa@project.iam.gserviceaccount.com
# GEE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Optional ---
# VERCEL=1
# PLAYWRIGHT_BASE_URL=http://localhost:3000
